*.pyc
__pycache__/
cpp/build/

# `infer_sequence --vis` output: one match image per frame, regenerated on demand
# from the images in `image/` (which ARE tracked - they are the demo input).
cpp/out/

# Conversion byproducts: rknn-toolkit2 dumps the ONNX graph at each of its
# internal optimisation stages into the CWD as `check<N>_<stage>.onnx`.  They are
# 35-75 MB each, are never read back, and are regenerated by every conversion.
check*.onnx

# Tool output (paths.outputs() defaults to reports/ here).  Reports are
# measurement artefacts - regenerable from the documented commands, never read
# back as input - so they stay out of version control even though they live
# inside the checkout.
reports/

# Reference dumps and one-off probe graphs, regenerated by the documented export
# commands (see paths.scratch()).  Everything here is an INPUT the tools write for
# their own verification runs, not a source file.
refs/
